#!/usr/bin/env python3
from collections.abc import Callable
from dataclasses import dataclass
from subprocess import CompletedProcess, run
from typing import Self, final

from my_utils.fntools import drop


@final
@dataclass(frozen=True, kw_only=True, slots=True)
class Cli:
    user: bool

    # not to flush out all of the unit's resources before it is started again
    preserve: bool
    try_: bool  # not to affect inactive units
    units: list[str]

    @classmethod
    def parse(cls) -> Self:
        from argparse import ArgumentParser

        parser = ArgumentParser(
            description="Wrapper for systemctl unit (re)start behavior."
        )

        parser.add_argument(
            "--user",
            action="store_true",
            help="Use --user mode for systemctl (run in user session).",
        )
        parser.add_argument(
            "--preserve",
            action="store_true",
            help="Preserve unit state (do not flush file descriptor store etc).",
        )
        parser.add_argument(
            "--try",
            dest="try_",
            action="store_true",
            help="Try to start only if the unit is not inactive (i.e., skip if not in memory).",
        )
        parser.add_argument(
            "units",
            nargs="+",
            help="The systemd unit name to operate on (e.g., nginx.service).",
        )

        args = parser.parse_args()
        return cls(
            user=args.user,
            units=args.units,
            preserve=args.preserve,
            try_=args.try_,
        )


@final
@dataclass(frozen=True, kw_only=True, slots=True)
class Systemctl:
    is_active: Callable[[str], bool]
    daemon_reload: Callable[[], CompletedProcess[bytes]]
    status: Callable[[str], CompletedProcess[bytes]]
    restart: Callable[[str], None]

    @classmethod
    def new(cls, user: bool, preserve: bool, try_: bool) -> Self:
        (
            is_active_cmd,
            daemon_reload_cmd,
            status_cmd,
            restart_preserve_cmd,
            restart_non_preserve_cmd,
        ) = (
            (
                (lambda unit: ["systemctl", "--user", "--quiet", "is-active", unit]),
                ["systemctl", "--user", "daemon-reload"],
                (lambda unit: ["systemctl", "--no-pager", "--user", "status", unit]),
                (lambda r, unit: ["systemctl", "--user", r, unit]),
                (
                    lambda unit: (
                        ["systemctl", "--user", "stop", unit],
                        ["systemctl", "--user", "start", unit],
                    )
                ),
            )
            if user
            else (
                (lambda unit: ["systemctl", "--quiet", "is-active", unit]),
                ["sudo", "systemctl", "daemon-reload"],
                (lambda unit: ["sudo", "systemctl", "--no-pager", "status", unit]),
                (lambda r, unit: ["sudo", "systemctl", r, unit]),
                (
                    lambda unit: (
                        ["sudo", "systemctl", "stop", unit],
                        ["sudo", "systemctl", "start", unit],
                    )
                ),
            )
        )

        is_active = lambda unit: run(is_active_cmd(unit)).returncode == 0
        daemon_reload = lambda: run(daemon_reload_cmd, check=True)
        status = lambda unit: run(status_cmd(unit))

        def restart_non_preserve_without_try(unit: str):
            stop, start = restart_non_preserve_cmd(unit)
            run(stop, check=True)
            run(start, check=True)

        def restart_non_preserve_with_try(unit: str):
            if is_active(unit):
                restart_non_preserve_without_try(unit)

        restart_subcmd, restart_non_preserve = (
            ("restart", restart_non_preserve_without_try)
            if not try_
            else ("try-restart", restart_non_preserve_with_try)
        )
        restart_preserve = lambda unit: drop(
            run(restart_preserve_cmd(restart_subcmd, unit), check=True)
        )
        restart = restart_preserve if preserve else restart_non_preserve

        return cls(
            is_active=is_active,
            daemon_reload=daemon_reload,
            status=status,
            restart=restart,
        )


def main():
    cli = Cli.parse()
    systemctl = Systemctl.new(cli.user, cli.preserve, cli.try_)
    systemctl.daemon_reload()
    for unit in cli.units:
        systemctl.restart(unit)
        systemctl.status(unit)


if __name__ == "__main__":
    main()
