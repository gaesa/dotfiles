#!/usr/bin/python
from argparse import ArgumentParser
from dataclasses import dataclass
from subprocess import run
from typing import final


def get_name(tree_ish: str = "HEAD") -> str:
    result = run(
        ["git", "name-rev", "--name-only", tree_ish], capture_output=True, text=True
    )
    output = result.stdout.rstrip()
    return output.removesuffix("~")


@final
@dataclass(frozen=True, kw_only=True)
class Cli:
    tree_ish: str

    @classmethod
    def parse(cls) -> "Cli":
        parser = ArgumentParser(description="Get branch name")
        parser.add_argument(
            "tree_ish",
            type=str,
            default="HEAD",
            nargs="?",
            help="The name of a tree-ish object (default: HEAD)",
        )
        args = parser.parse_args()
        return cls(tree_ish=args.tree_ish)


def main():
    tree_ish = Cli.parse().tree_ish
    print(get_name(tree_ish))


if __name__ == "__main__":
    main()
