#!/usr/bin/python
"""
Fix the annoying `✘ PIPE`
See also: https://public-inbox.org/git/87v9b8d6zx.fsf@evledraar.gmail.com/T/
"""

import os
import sys
from collections.abc import Callable
from subprocess import run


def suppress_err_status_when(
    returncode: int, argv: list[str], predicate: Callable[[int, list[str]], bool]
) -> None:
    if predicate(returncode, argv):
        return
    else:
        raise SystemExit(returncode)


def main():
    argv = sys.argv
    if len(argv) > 1 and argv[1] not in {"d", "diff", "difftool"}:
        env = os.environ.copy()
        env["TZ"] = "UTC"
    else:
        env = os.environ
    p = run(["git", *argv[1:]], env=env)
    code_range = {141, -13}
    subcmd = {"l", "log", "ls", "la", "lsa"}
    suppress_err_status_when(
        p.returncode,
        argv,
        predicate=lambda code, argv: (
            code == 0 or (code in code_range and argv[1] in subcmd)
        ),
    )


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
