#!/usr/bin/env python3
import sys
import time
from collections.abc import Callable, Iterable
from concurrent.futures import ThreadPoolExecutor
from subprocess import Popen
from typing import Type

from result import Err, Ok, Result

import clean_home


class MaxRetriesExceededError(Exception):
    pass


def monitor_process(
    process: list[str],
    successful_duration: float = 5.0,
    poll_interval: float = 1.0,
    max_retry_times: int = 3,
) -> Result[None, Type[MaxRetriesExceededError]]:
    process_handle = Popen(process, start_new_session=True)
    retry_times = 0
    start_instant = time.monotonic()
    while True:
        polled = process_handle.poll()
        if polled is None:
            elapsed = time.monotonic() - start_instant
            if elapsed > successful_duration:
                return Ok(None)
            else:
                time.sleep(poll_interval)
        else:
            if polled == 0:
                return Ok(None)
            else:
                if retry_times == max_retry_times:
                    return Err(MaxRetriesExceededError)
                else:
                    process_handle = Popen(process, start_new_session=True)
                    start_instant = time.monotonic()
                    retry_times += 1


def start_applications(executor: ThreadPoolExecutor, processes: Iterable[list[str]]):
    processes_list = list(processes)
    futures = executor.map(monitor_process, processes_list)

    for i, future in enumerate(futures):
        if future.is_err():
            print(f"Process {processes_list[i]} failed", file=sys.stderr)


def run_after_online(f: Callable[[], None]):
    from my_utils.network import wait_online

    wait_online()
    f()


def main():
    APPLICATIONS = [["koi"], ["goldendict"], ["keepassxc"], ["flameshot"]]
    APPLICATIONS_NET = [["thunderbird"]]
    WAIT_DURATION = 5.0

    time.sleep(WAIT_DURATION)
    with ThreadPoolExecutor() as executor:
        future = executor.submit(start_applications, executor, APPLICATIONS)
        future_net = executor.submit(
            run_after_online, lambda: start_applications(executor, APPLICATIONS_NET)
        )

        # catch possible exceptions
        _ = future.result()
        _ = future_net.result()

    clean_home.main()


if __name__ == "__main__":
    main()
