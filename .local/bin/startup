#!/usr/bin/env python3
import json
import logging
import os
import time
from collections.abc import Callable
from concurrent.futures import ThreadPoolExecutor
from subprocess import Popen
from typing import Any, Self, Type

import clean_home
from platformdirs import user_config_path
from pydantic import BaseModel, ValidationError
from result import Err, Ok, Result, as_result

logging.basicConfig(level=os.environ.get("LOG_LEVEL_PROGRAM", "WARNING").upper())
logger = logging.getLogger(__name__)


class MaxRetriesExceededError(Exception):
    pass


def monitor_process(
    process: list[str],
    successful_duration: float = 5.0,
    poll_interval: float = 1.0,
    max_retry_times: int = 3,
) -> Result[None, Type[MaxRetriesExceededError]]:
    process_handle = Popen(process, start_new_session=True)
    retry_times = 0
    start_instant = time.monotonic()
    while True:
        polled = process_handle.poll()
        if polled is None:
            elapsed = time.monotonic() - start_instant
            if elapsed > successful_duration:
                return Ok(None)
            else:
                time.sleep(poll_interval)
        else:
            if polled == 0:
                return Ok(None)
            else:
                if retry_times == max_retry_times:
                    return Err(MaxRetriesExceededError)
                else:
                    process_handle = Popen(process, start_new_session=True)
                    start_instant = time.monotonic()
                    retry_times += 1
                    logger.info(
                        "[%d/%d] Retry running process %s",
                        retry_times,
                        max_retry_times,
                        str(process),
                    )


def start_applications(
    offline: list[list[str]], online: list[list[str]], *, wait_duration: float
):
    def start(executor: ThreadPoolExecutor, processes: list[list[str]]):
        futures = executor.map(monitor_process, processes)

        for i, future in enumerate(futures):
            if future.is_err():
                logger.error("Process %s failed", str(processes[i]))

    def run_after_online(f: Callable[[], None]):
        from my_utils.network import wait_online

        wait_online()
        f()

    time.sleep(wait_duration)

    with ThreadPoolExecutor() as executor:
        future = executor.submit(start, executor, offline)
        future_net = executor.submit(run_after_online, lambda: start(executor, online))

        # catch possible exceptions
        _ = future.result()
        _ = future_net.result()


class BaseModelR(BaseModel):
    @classmethod
    @as_result(ValidationError)
    def model_validate_r(
        cls,
        obj: Any,
        *,
        strict: bool | None = None,
        from_attributes: bool | None = None,
        context: Any | None = None,
    ) -> Self:
        return cls.model_validate(
            obj, strict=strict, from_attributes=from_attributes, context=context
        )


class Applications(BaseModelR):
    offline: list[list[str]]
    online: list[list[str]]


def main():
    config_path = user_config_path().joinpath("startup/config.json")
    if config_path.is_file():
        config = Applications.model_validate_r(json.loads(config_path.read_text()))
        match config:
            case Ok(cfg):
                start_applications(cfg.offline, cfg.online, wait_duration=2.0)
            case Err(e):
                logger.error(e)

    clean_home.main()


if __name__ == "__main__":
    main()
