#!/usr/bin/python
from dataclasses import dataclass
from subprocess import run
from typing import final


def get_commit_count() -> int:
    result = run(
        ["git", "rev-list", "--count", "HEAD"], capture_output=True, text=True
    ).stdout.rstrip()
    return int(result)


def get_commit_count_with_author() -> str:
    return run(
        ["git", "shortlog", "-s"], capture_output=True, text=True
    ).stdout.rstrip()


@final
@dataclass(frozen=True, kw_only=True, slots=True)
class Cli:
    author: bool

    @classmethod
    def parse(cls) -> "Cli":
        from argparse import ArgumentParser

        parser = ArgumentParser(description="Get commit count from git repository")
        parser.add_argument(
            "--author", action="store_true", help="Get commit count with author details"
        )
        args = parser.parse_args()
        return cls(author=args.author)


def main():
    cli = Cli.parse()
    if cli.author:
        print(get_commit_count_with_author())
    else:
        print(get_commit_count())


if __name__ == "__main__":
    main()
