#!/usr/bin/env python3
from subprocess import run
from argparse import ArgumentParser
from dataclasses import dataclass
from typing import final


@final
@dataclass(kw_only=True, frozen=True)
class Cli:
    source: str
    target: str

    @classmethod
    def parse(cls) -> "Cli":
        parser = ArgumentParser(description="Encrypt a file or directory using 7z")
        parser.add_argument("source", help="The file or directory to encrypt")
        parser.add_argument("target", help="The output encrypted file")
        return cls(**vars(parser.parse_args()))


def encrypt(source: str, target: str) -> None:
    run(
        [
            "7z",
            "a",
            "-t7z",
            "-m0=lzma2",
            # "-mx=9",
            "-mfb=64",
            "-md=32m",
            "-ms=on",
            "-mhe=on",
            "-p",
            target,
            source,
        ],
        check=True,
    )


def main():
    cli = Cli.parse()
    encrypt(cli.source, cli.target)


if __name__ == "__main__":
    main()
