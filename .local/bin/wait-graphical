#!/usr/bin/env python3
from subprocess import run
from time import sleep

from my_utils.stream import Stream


def is_env_prepared() -> bool:
    def get_env() -> str:
        p = run(
            ["systemctl", "--user", "--no-pager", "show-environment"],
            capture_output=True,
            text=True,
            check=True,
        )
        return p.stdout

    return Stream(get_env().splitlines()).any_match(
        lambda s: s.startswith("DISPLAY") or s.startswith("WAYLAND_DISPLAY")
    )


def main():
    while True:
        if is_env_prepared():
            return
        else:
            sleep(1)


if __name__ == "__main__":
    main()
