#!/usr/bin/python
from argparse import Action, ArgumentParser
from dataclasses import dataclass
from typing import Self, final

from my_utils.git import get_tracked_dirs
from my_utils.stream import Stream


@final
@dataclass(frozen=True, kw_only=True, slots=True)
class Cli:
    path: str
    tree_ish: list[str]

    @classmethod
    def parse(cls) -> Self:
        class AppendWithoutDefault(Action):
            def __init__(self, *args, **kwargs):
                super(AppendWithoutDefault, self).__init__(*args, **kwargs)
                self._is_passed = False

            def __call__(  # pyright: ignore [reportIncompatibleMethodOverride]
                self, _, namespace, values, __
            ):
                if not self._is_passed:
                    setattr(namespace, self.dest, [])
                    self._is_passed = True
                    getattr(namespace, self.dest).append(values)
                else:
                    getattr(namespace, self.dest).append(values)

        parser = ArgumentParser(description="Get tracked directories")
        parser.add_argument(
            "path",
            type=str,
            default=".",
            nargs="?",
            help="The path to get tracked directories",
        )
        parser.add_argument(
            "--tree-ish",
            type=str,
            default=["HEAD"],
            action=AppendWithoutDefault,
            help="The name of a tree-ish object (default: HEAD)",
        )
        args = parser.parse_args()
        return cls(
            path=args.path, tree_ish=Stream(args.tree_ish).unique_everseen().to_list()
        )


def main():
    cli = Cli.parse()
    (
        Stream(cli.tree_ish)
        .flatmap(lambda obj: get_tracked_dirs(cli.path, obj))
        .unique_everseen()
        .for_each(print)
    )


if __name__ == "__main__":
    main()
