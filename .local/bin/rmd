#!/usr/bin/env python3
import argparse
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path
from shutil import rmtree
from sys import stderr
from typing import Self, final


@final
@dataclass(frozen=True, kw_only=True, slots=True)
class Cli:
    paths: list[Path]
    preserve_root: bool
    quiet: bool

    @classmethod
    def parse(cls) -> Self:
        parser = argparse.ArgumentParser(
            description="Remove recursively empty directories."
        )
        parser.add_argument(
            "paths", nargs="+", type=Path, help="The root directories to check."
        )
        parser.add_argument(
            "-p",
            "--preserve-root",
            action="store_true",
            help="Preserve the root directory.",
        )
        parser.add_argument(
            "-q",
            "--quiet",
            action="store_true",
            help="Suppress warnings and informational output.",
        )
        args = parser.parse_args()
        return cls(**vars(args))


def is_recursively_empty_dir(dir_path: Path) -> bool:
    for entry in dir_path.iterdir():
        if (not entry.is_dir()) or (not is_recursively_empty_dir(entry)):
            return False
    return True


def rm_dir_or_link(dir: Path):
    if dir.is_symlink():
        dir.unlink()
    else:
        rmtree(dir)


def make_remove(preserve_root: bool) -> Callable[[Path], None]:
    def recursively_rm(path: Path):
        for p in path.iterdir():
            rm_dir_or_link(p)

    return rm_dir_or_link if not preserve_root else recursively_rm


def make_handle_dir(
    remove: Callable[[Path], None], quiet: bool
) -> Callable[[Path], None]:
    def handle_dir_not_quiet(path: Path):
        if is_recursively_empty_dir(path):
            remove(path)
        else:
            print(
                f"Path '{path}' is not an recursively empty directory.",
                file=stderr,
            )

    def handle_dir_quiet(path: Path):
        if is_recursively_empty_dir(path):
            remove(path)

    return handle_dir_not_quiet if not quiet else handle_dir_quiet


def make_handle_path(
    handle_dir: Callable[[Path], None], quiet: bool
) -> Callable[[Path], None]:
    def handle_path_not_quiet(path: Path):
        if path.is_dir():
            handle_dir(path)
        else:
            print(f"Path '{path}' is not a directory.", file=stderr)

    def handle_path_quiet(path: Path):
        if path.is_dir():
            handle_dir(path)

    return handle_path_not_quiet if not quiet else handle_path_quiet


def main():
    cli = Cli.parse()

    remove = make_remove(cli.preserve_root)
    quiet = cli.quiet
    handle_dir = make_handle_dir(remove, quiet)
    handle_path = make_handle_path(handle_dir, quiet)

    for path in cli.paths:
        handle_path(path)


if __name__ == "__main__":
    main()
