#!/usr/bin/env python3
from argparse import ArgumentParser
from dataclasses import dataclass
from os.path import dirname, join
from shutil import move
from typing import final


@final
@dataclass(frozen=True, kw_only=True)
class Cli:
    old_path: str
    new_name: str

    @classmethod
    def parse(cls) -> "Cli":
        parser = ArgumentParser(
            description="Rename a file or directory under a directory."
        )
        parser.add_argument(
            "old_path", type=str, help="The path to the file or directory to be renamed"
        )
        parser.add_argument(
            "new_name", type=str, help="The new name for the file or directory"
        )
        args = parser.parse_args()
        return cls(old_path=args.old_path, new_name=args.new_name)


def main():
    cli = Cli.parse()
    new_path = join(dirname(cli.old_path), cli.new_name)
    move(cli.old_path, new_path)


if __name__ == "__main__":
    main()
